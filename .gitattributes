# Aset media besar disimpan via Git LFS (lihat README > Aset besar).
# SVG & PNG/JPG kecil (logo, ikon) sengaja TIDAK di-LFS agar mudah di-diff.
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.m4a  filter=lfs diff=lfs merge=lfs -text
*.aac  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mov  filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.ai   filter=lfs diff=lfs merge=lfs -text
*.fig  filter=lfs diff=lfs merge=lfs -text
*.zip  filter=lfs diff=lfs merge=lfs -text
# Screenshot/foto resolusi tinggi: taruh di folder `media/` agar ikut LFS.
public/**/media/** filter=lfs diff=lfs merge=lfs -text
# Narasi (voice-over) hasil `npm run narasi`: klip kecil (~50 KB) disimpan
# sebagai file git biasa agar bisa dirender ulang tanpa Git LFS.
public/narration/** -filter -diff -merge -text

# Efek suara (SFX) sintetis kecil hasil `scripts/build-sfx.mjs`: file git biasa
# (upload Git LFS diblokir dari sesi cloud; total < 0,5 MB).
public/sfx/** -filter -diff -merge -text
